"use strict";
var centerSpider = function() {
    // Получаем элемент стены
    var wall = document.querySelector(".wall");
    // Получаем элемент паука
    var spider = document.querySelector(".spider");
    // Получаем размеры стены, исключая бордеры
    var wallWidth = wall.clientWidth;
    var wallHeight = wall.clientHeight;
    // Получаем размеры паука
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    // Рассчитываем верхнюю и левую позицию для центрирования паука
    var spiderTop = (wallHeight - spiderHeight) / 2;
    var spiderLeft = (wallWidth - spiderWidth) / 2;
    // Устанавливаем позицию паука
    spider.style.top = "".concat(spiderTop, "px");
    spider.style.left = "".concat(spiderLeft, "px");
};
// Вызываем функцию для центрирования паука
centerSpider();

